# Copy to .env and fill in. NEVER commit the real .env.

# MySQL "Evergreen". In DEV you connect through an SSH tunnel to the droplet
# (see README -> "Connecting to the Evergreen database from dev").
# Dev (tunnel on local 3306):
DATABASE_URL="mysql://<dev-user>:<password>@127.0.0.1:3306/Evergreen"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"     # prod: https://app.achievers.es

# Existing Express server ("server-achievers"). For now EVERY request the
# dashboard sends to it uses the PROD URL — even in dev. Leave this unset to
# fall back to the prod default; only override when a local/dev server exists.
SERVER_URL="https://server.achieversacademy.es"

# Sales platform (achievers-comercial-system). Feeds the VIP sales indicator in
# /proyectos through its public-project-metrics Edge Function. The key is the
# function's PUBLIC_PROJECT_METRICS_API_KEY (Supabase secret).
SALES_METRICS_URL="https://bgbbckfqdplingyhnmbn.supabase.co/functions/v1/public-project-metrics"
SALES_METRICS_API_KEY=""

# Public stats API
PUBLIC_STATS_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM="Achievers <no-reply@achievers.es>"

# First-admin bootstrap (used by pnpm db:seed)
ADMIN_EMAIL=""

NODE_ENV="development"
PORT="3000"
