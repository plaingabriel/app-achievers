# Copy to .env for local dev. On the droplet, the real file lives at
# /etc/achievers-app/.env (chmod 600). Never commit the real .env.

# MySQL — DEV POINTS AT PROD (acknowledged, see ADR 0011). Use a SELECT-only
# user by default; switch to a write-capable user only for migration windows.
DATABASE_URL="mysql://readonly_user:password@127.0.0.1:3306/achievers"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="https://app.achieversacademy.es"

# Resend
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="App Achievers <no-reply@achieversacademy.es>"

# First-admin bootstrap (used once by pnpm db:seed)
ADMIN_EMAIL="you@achieversacademy.es"

NODE_ENV="development"
PORT="3000"
